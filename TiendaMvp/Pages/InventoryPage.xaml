<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TiendaMvp.Pages.InventoryPage"
             Title="Inventario"
             BackgroundColor="{AppThemeBinding Light=#F5F7F8, Dark=#11181C}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="20,18" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Catálogo y existencias" FontSize="14" TextColor="{AppThemeBinding Light=#66757D, Dark=#AEBBC2}" /><Label Text="Inventario" FontSize="26" FontAttributes="Bold" /></VerticalStackLayout><Button Grid.Column="1" Text="+ Producto" Clicked="OnNewProductClicked" /></Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8"><SearchBar x:Name="SearchBox" Placeholder="Buscar por nombre, código o QR" TextChanged="OnSearchChanged" /><Button Grid.Column="1" Text="Escanear" Clicked="OnScanClicked" /></Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8"><Picker x:Name="CategoryPicker" Title="Filtrar por categoría" SelectedIndexChanged="OnCategoryChanged" /><Button Grid.Column="1" Text="Categorías" Clicked="OnCategoriesClicked" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#512BD4, Dark=#AC99EA}" /></Grid>
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10"><Border x:Name="InventoryValuePanel" Padding="12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1D272C}" Stroke="{AppThemeBinding Light=#D9E1E5, Dark=#344149}" StrokeShape="RoundRectangle 14"><VerticalStackLayout Spacing="3"><Label Text="Valor estimado" FontSize="12" TextColor="{AppThemeBinding Light=#66757D, Dark=#AEBBC2}" /><Label x:Name="InventoryValueLabel" Text="$0" FontSize="19" FontAttributes="Bold" /></VerticalStackLayout></Border><Border Grid.Column="1" Padding="12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1D272C}" Stroke="{AppThemeBinding Light=#D9E1E5, Dark=#344149}" StrokeShape="RoundRectangle 14"><VerticalStackLayout Spacing="3"><Label Text="Alertas de mínimo" FontSize="12" TextColor="{AppThemeBinding Light=#66757D, Dark=#AEBBC2}" /><Label x:Name="LowStockLabel" Text="0 productos" FontSize="19" FontAttributes="Bold" /></VerticalStackLayout></Border></Grid>
        <Grid Grid.Row="4" RowDefinitions="Auto,*" RowSpacing="10"><VerticalStackLayout Spacing="8"><Label Text="Productos" FontSize="17" FontAttributes="Bold" /><HorizontalStackLayout Spacing="5"><Button Text="Ajustar" FontSize="12" Padding="10,6" Clicked="OnAdjustClicked" /><Button Text="Conteo" FontSize="12" Padding="10,6" Clicked="OnCountClicked" /><Button Text="Historial" FontSize="12" Padding="10,6" Clicked="OnMovementsClicked" /></HorizontalStackLayout></VerticalStackLayout><CollectionView Grid.Row="1" x:Name="ProductsCollection" EmptyView="No hay productos que mostrar"><CollectionView.ItemTemplate><DataTemplate><Border Margin="0,0,0,10" Padding="14" BackgroundColor="{AppThemeBinding Light=White, Dark=#1D272C}" Stroke="{AppThemeBinding Light=#D9E1E5, Dark=#344149}" StrokeShape="RoundRectangle 14"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><VerticalStackLayout Spacing="3"><Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" LineBreakMode="TailTruncation" MaxLines="1" /><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding CategoryName}" FontSize="12" LineBreakMode="TailTruncation" TextColor="{AppThemeBinding Light=#66757D, Dark=#AEBBC2}" /><Label Grid.Column="1" Text="{Binding Status}" FontSize="12" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Light=#66757D, Dark=#AEBBC2}" /></Grid><Label Text="{Binding InternalCode, StringFormat='Código: {0}'}" FontSize="12" LineBreakMode="TailTruncation" TextColor="{AppThemeBinding Light=#66757D, Dark=#AEBBC2}" /><Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0"><Label Text="{Binding Stock, StringFormat='Existencia: {0:0.##}'}" FontSize="13" /><Label Grid.Column="1" Text="{Binding SalePrice, StringFormat='Venta: ${0:0.##}'}" FontSize="13" HorizontalTextAlignment="End" /></Grid></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="6"><Button Text="Editar" FontSize="12" Padding="10,6" CommandParameter="{Binding .}" Clicked="OnEditProductClicked" /><Button Text="QR" FontSize="12" Padding="10,6" CommandParameter="{Binding .}" Clicked="OnQrProductClicked" /><Button Text="Ajustar" FontSize="12" Padding="10,6" CommandParameter="{Binding .}" Clicked="OnAdjustProductClicked" /></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid>
    </Grid>
</ContentPage>
