<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TiendaMvp.Pages.ProductEditorPage"
             Title="Producto"
             BackgroundColor="{AppThemeBinding Light=#F5F7F8, Dark=#11181C}">
    <ScrollView>
        <VerticalStackLayout Padding="20,18" Spacing="12">
            <Label x:Name="PageTitle" Text="Nuevo producto" FontSize="26" FontAttributes="Bold" />
            <Label Text="Información básica" FontSize="14" FontAttributes="Bold" Margin="0,8,0,0" />
            <Entry x:Name="NameEntry" Placeholder="Nombre del producto" />
            <Editor x:Name="DescriptionEditor" Placeholder="Descripción (opcional)" AutoSize="TextChanges" MinimumHeightRequest="80" />
            <VerticalStackLayout Spacing="5">
                <Label Text="Código interno (generado automáticamente)" FontSize="13" />
                <Entry x:Name="CodeEntry"
                       IsReadOnly="True"
                       TextColor="{AppThemeBinding Light=#66757D, Dark=#AEBBC2}"
                       BackgroundColor="{AppThemeBinding Light=#E9EDF0, Dark=#202A2F}"
                       Placeholder="Se asignará al crear el producto" />
                <Label Text="Este código se usará para búsquedas y no cambia al editar el producto."
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#66757D, Dark=#AEBBC2}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="5">
                <Label Text="Unidad de medida *" FontSize="13" />
                <Picker x:Name="UnitPicker" Title="Selecciona unidad" />
            </VerticalStackLayout>
            <Picker x:Name="CategoryPicker" Title="Categoría" />
            <Label Text="Precios e inventario" FontSize="14" FontAttributes="Bold" Margin="0,8,0,0" />
            <VerticalStackLayout Spacing="5">
                <Label Text="Costo de compra" FontSize="13" />
                <Entry x:Name="PurchaseCostEntry" Keyboard="Numeric" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="5">
                <Label Text="Precio de venta" FontSize="13" />
                <Entry x:Name="SalePriceEntry" Keyboard="Numeric" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="5">
                <Label Text="Existencia mínima" FontSize="13" />
                <Entry x:Name="MinimumStockEntry" Keyboard="Numeric" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="5">
                <Label Text="Impuesto (%)" FontSize="13" />
                <Entry x:Name="TaxRateEntry" Keyboard="Numeric" />
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="InitialStockSection" Spacing="5">
                <Label Text="Existencia inicial" FontSize="13" />
                <Entry x:Name="InitialStockEntry" Keyboard="Numeric" />
            </VerticalStackLayout>
            <Label Text="Imagen" FontSize="14" FontAttributes="Bold" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Border WidthRequest="82" HeightRequest="82" BackgroundColor="{AppThemeBinding Light=#E9EDF0, Dark=#202A2F}" StrokeThickness="0" StrokeShape="RoundRectangle 14"><Image x:Name="ProductImage" Aspect="AspectFill" /></Border><Button Grid.Column="1" Text="Elegir fotografía" Clicked="OnChoosePhotoClicked" HorizontalOptions="Start" /></Grid>
            <Button x:Name="SaveButton" Text="Guardar producto" Clicked="OnSaveClicked" Margin="0,10,0,0" />
            <Button x:Name="QrButton" Text="Ver y compartir QR" Clicked="OnQrClicked" IsVisible="False" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#512BD4, Dark=#AC99EA}" />
            <Button x:Name="ToggleButton" Text="Desactivar producto" Clicked="OnToggleClicked" IsVisible="False" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#A5661D, Dark=#F0C17D}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
